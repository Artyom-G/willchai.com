{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "willchai-standby",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "standby.willchai.com",
      "custom_domain": true
    }
  ]
}
