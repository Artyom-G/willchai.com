---
import "../../styles/photography.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import PhotographyFooter from "../../components/PhotographyFooter.astro";
import shuffleManifest from "../../data/photographyShuffle.json";

const photographs = [
  {
    key: "nessa",
    src: "/photography/concert-nessa.avif",
    alt: "Singer Nessa Barrett performing beneath warm stage lights",
    caption: "Nessa Barrett, live performance, 2026",
    width: 1920,
    height: 2559,
  },
  {
    key: "lakeshore",
    src: "/photography/portrait-lakeshore.webp",
    alt: "Portrait of a person standing beside the water",
    caption: "Lakeshore portrait",
    width: 1707,
    height: 2560,
  },
  {
    key: "mcmaster",
    src: "/photography/concert-mcmaster.avif",
    alt: "A vocalist performing in a McMaster hoodie",
    caption: "Live performance at McMaster University, 2025",
    width: 1920,
    height: 2400,
  },
  {
    key: "formal",
    src: "/photography/portrait-formal.webp",
    alt: "Portrait of a person wearing a suit outdoors",
    caption: "Portrait",
    width: 1707,
    height: 2560,
  },
  {
    key: "purple",
    src: "/photography/concert-purple.avif",
    alt: "A concert performer lit by purple stage light",
    caption: "Live performance, 2025",
    width: 1920,
    height: 2400,
  },
  {
    key: "nightlife",
    src: "/photography/event-nightlife.webp",
    alt: "Nightlife event portrait beneath blue and purple light",
    caption: "Nightlife event",
    width: 1920,
    height: 2879,
  },
  {
    key: "couple",
    src: "/photography/portrait-couple.webp",
    alt: "A couple standing together in soft light",
    caption: "Couple portrait",
    width: 1722,
    height: 2560,
  },
  {
    key: "graduation",
    src: "/photography/portrait-graduation.webp",
    alt: "Graduation portrait made outdoors",
    caption: "Graduation portrait",
    width: 1920,
    height: 2688,
  },
  {
    key: "group",
    src: "/photography/portrait-group.webp",
    alt: "A group portrait made outdoors in warm evening light",
    caption: "Group portrait",
    width: 1920,
    height: 1536,
  },
  {
    key: "property",
    src: "/photography/property-aerial.webp",
    alt: "A winter aerial photograph of a residential property",
    caption: "Residential property, Ontario",
    width: 1920,
    height: 1920,
  },
  {
    key: "beverage",
    src: "/photography/product-beverage.webp",
    alt: "A beverage product photograph with a bright studio composition",
    caption: "Beverage study",
    width: 1920,
    height: 2560,
  },
  {
    key: "eyewear",
    src: "/photography/product-eyewear.webp",
    alt: "An eyewear product photograph with a clean studio arrangement",
    caption: "Eyewear study",
    width: 1920,
    height: 2333,
  },
];

const photographByKey = Object.fromEntries(photographs.map((photograph) => [photograph.key, photograph]));

const featuredSpreads = [
  [photographByKey.group, photographByKey.formal],
  [photographByKey.mcmaster, photographByKey.couple, photographByKey.nightlife],
  [photographByKey.graduation, photographByKey.purple],
  [photographByKey.eyewear, photographByKey.property, photographByKey.beverage],
];

const clients = [
  { name: "Luxetints", logo: "/photography/clients/luxetints.avif" },
  { name: "Health Sciences Musical", logo: "/photography/clients/health-sciences-musical.avif" },
  { name: "McMaster Film Production Club", logo: "/photography/clients/mcmaster-film-production-club.avif" },
  { name: "Matt", logo: "/photography/clients/matt.avif" },
  { name: "McMaster A Cappella", logo: "/photography/clients/mcmaster-a-cappella.avif" },
  { name: "McMaster University", logo: "/photography/clients/mcmaster.avif" },
  { name: "SJK School", logo: "/photography/clients/sjk-school.avif" },
  { name: "McMaster BHSS", logo: "/photography/clients/mcmaster-bhss.avif" },
  { name: "Platinum Moon", logo: "/photography/clients/platinum-moon.avif" },
  { name: "Snazzy Labs", logo: "/photography/clients/snazzy-labs.avif" },
];

const shufflePhotographs = shuffleManifest.images;
const shuffleBatchSize = 36;
const shuffleBatches = Array.from(
  { length: Math.ceil(shufflePhotographs.length / shuffleBatchSize) },
  (_, index) => shufflePhotographs.slice(index * shuffleBatchSize, (index + 1) * shuffleBatchSize),
);
---

<BaseLayout
  title="Photography | Will Chai"
  description="Portrait, event, performance, product, property, and film photography by Will Chai."
  path="/photography/"
  pageClass="photographyPage"
>
  <script slot="head" is:inline src="/scripts/photography.js" defer></script>
  <div class="pageShell">
    <SiteHeader current="photography" />
    <main id="main" class="pageMain">
      <div class="photographyIdentityBar">
        <h1 id="photographyTitle">Will Chai Photography</h1>
        <a href="#pricing">Pricing</a>
      </div>
      <section class="photographyOpening" aria-labelledby="photographyTitle">
        <figure class="photographyOpeningMedia">
          <img
            src="/photography/concert-nessa.avif"
            alt="Singer Nessa Barrett performing beneath warm stage lights"
            width="1920"
            height="2559"
            fetchpriority="high"
          />
          <figcaption>{photographByKey.nessa.caption}</figcaption>
        </figure>
        <figure class="photographyOpeningMedia">
          <img
            src={photographByKey.lakeshore.src}
            alt={photographByKey.lakeshore.alt}
            width={photographByKey.lakeshore.width}
            height={photographByKey.lakeshore.height}
            decoding="async"
          />
          <figcaption>{photographByKey.lakeshore.caption}</figcaption>
        </figure>
      </section>

      <section class="featuredSequence" aria-labelledby="featuredPhotographyTitle">
        <h2 id="featuredPhotographyTitle" class="visuallyHidden">Featured photographs</h2>
        {
          featuredSpreads.map((spread) => (
            <div class="featuredSpread">
              {spread.map((photograph) => (
                <figure class="featuredFigure" style={`--photograph-ratio: ${photograph.width / photograph.height}`}>
                  <img
                    src={photograph.src}
                    alt={photograph.alt}
                    width={photograph.width}
                    height={photograph.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{photograph.caption}</figcaption>
                </figure>
              ))}
            </div>
          ))
        }
      </section>

      <section class="clientProof" aria-labelledby="clientProofTitle">
        <h2 id="clientProofTitle">Organizations featuring my work</h2>
        <div class="clientLogoRow">
          {
            clients.map((client) => (
              <figure class="clientLogo">
                <img
                  src={client.logo}
                  alt=""
                  width="280"
                  height="140"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{client.name}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section class="photographyPricing" id="pricing" aria-labelledby="photographyPricingTitle" tabindex="-1">
        <div class="pricingTitleBlock">
          <h2 id="photographyPricingTitle">Pricing</h2>
          <p>I photograph portraits and events in Hamilton and across Ontario.</p>
        </div>
        <div class="pricingDetails">
          <h3>Custom quotes</h3>
          <p class="pricingIntroduction">
            Share your date, location, and what you have in mind. I’ll put together a quote covering photography, editing, delivery, travel, and any outside costs.
          </p>
          <dl class="pricingFacts">
            <div>
              <dt>Your photographs</dt>
              <dd>Final edited images, with delivery timing agreed in your quote.</dd>
            </div>
            <div>
              <dt>Booking terms</dt>
              <dd>The service policy covers revisions, delivery, and the satisfaction request window.</dd>
            </div>
          </dl>
          <div class="pricingActions">
            <a class="pricingAction" href="mailto:me@willchai.com?subject=Photography%20inquiry">Tell me about your shoot<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg></a>
            <a class="pricingPolicy" href="/photography/services-policy.pdf">Read the service policy</a>
          </div>
        </div>
      </section>

      <section class="shuffleSection" aria-labelledby="shuffleTitle">
        <header class="shuffleHeader">
          <h2 id="shuffleTitle">A shuffle</h2>
          <div class="shuffleNavigation">
            <button type="button" data-shuffle-reset aria-label="Shuffle the photographs">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h3c4 0 8 12 12 12h3M17 14l4 4-4 4M3 18h3c1.5 0 3-1.7 4.5-4M13.5 10C15 7.7 16.5 6 18 6h3M17 2l4 4-4 4" /></svg>
              Shuffle
            </button>
            <a href="#photography-contact">Contact</a>
          </div>
        </header>
        <div class="shuffleGallery" data-shuffle-gallery>
          {
            shuffleBatches.map((batch, batchIndex) => (
              <div class="shuffleBatch" data-shuffle-batch hidden={batchIndex > 0}>
                {batch.map((photograph, index) => (
                  <figure class="shuffleItem" data-shuffle-item>
                    <img
                      src={batchIndex === 0 ? photograph.src : undefined}
                      data-src={batchIndex > 0 ? photograph.src : undefined}
                      alt={`Portfolio photograph ${batchIndex * shuffleBatchSize + index + 1}`}
                      width={photograph.width}
                      height={photograph.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                ))}
              </div>
            ))
          }
        </div>
        <div class="shuffleControls">
          <button type="button" data-shuffle-more>Load more photographs</button>
          <a href="#photography-contact">Get in touch<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7" /></svg></a>
          <p class="visuallyHidden" data-shuffle-status aria-live="polite">{shuffleBatchSize} photographs shown</p>
        </div>
        <noscript><style>[data-shuffle-more], [data-shuffle-reset] { display: none; }</style></noscript>
      </section>
    </main>
    <PhotographyFooter />
  </div>
</BaseLayout>
