---
import "../../styles/photography.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhotographyFooter from "../../components/PhotographyFooter.astro";
import PhotographyCollection from "../../components/PhotographyCollection.astro";
import PhotographyLightbox from "../../components/PhotographyLightbox.astro";
import PhotographyArcade from "../../components/PhotographyArcade.astro";
import shuffleManifest from "../../data/photographyShuffle.json";

const photographs = [
  {
    key: "nessa",
    src: "/photography/concert-nessa.avif",
    alt: "Singer Nessa Barrett performing beneath warm stage lights",
    caption: "Nessa Barrett, live performance, 2026",
    width: 1920,
    height: 2559,
  },
  {
    key: "lakeshore",
    src: "/photography/portrait-lakeshore.webp",
    alt: "Portrait of a person standing beside the water",
    caption: "Lakeshore portrait",
    width: 1707,
    height: 2560,
  },
  {
    key: "mcmaster",
    src: "/photography/concert-mcmaster.avif",
    alt: "A vocalist performing in a McMaster hoodie",
    caption: "Live performance at McMaster University, 2025",
    width: 1920,
    height: 2400,
  },
  {
    key: "formal",
    src: "/photography/portrait-formal.webp",
    alt: "Portrait of a person wearing a suit outdoors",
    caption: "Portrait",
    width: 1707,
    height: 2560,
  },
  {
    key: "purple",
    src: "/photography/concert-purple.avif",
    alt: "A concert performer lit by purple stage light",
    caption: "Live performance, 2025",
    width: 1920,
    height: 2400,
  },
  {
    key: "nightlife",
    src: "/photography/event-nightlife.webp",
    alt: "Nightlife event portrait beneath blue and purple light",
    caption: "Nightlife event",
    width: 1920,
    height: 2879,
  },
  {
    key: "couple",
    src: "/photography/portrait-couple.webp",
    alt: "A couple standing together in soft light",
    caption: "Couple portrait",
    width: 1722,
    height: 2560,
  },
  {
    key: "graduation",
    src: "/photography/portrait-graduation.webp",
    alt: "Graduation portrait made outdoors",
    caption: "Graduation portrait",
    width: 1920,
    height: 2688,
  },
  {
    key: "group",
    src: "/photography/portrait-group.webp",
    alt: "A group portrait made outdoors in warm evening light",
    caption: "Group portrait",
    width: 1920,
    height: 1536,
  },
  {
    key: "property",
    src: "/photography/property-aerial.webp",
    alt: "A winter aerial photograph of a residential property",
    caption: "Residential property, Ontario",
    width: 1920,
    height: 1920,
  },
  {
    key: "beverage",
    src: "/photography/product-beverage.webp",
    alt: "A beverage product photograph with a bright studio composition",
    caption: "Beverage study",
    width: 1920,
    height: 2560,
  },
  {
    key: "eyewear",
    src: "/photography/product-eyewear.webp",
    alt: "An eyewear product photograph with a clean studio arrangement",
    caption: "Eyewear study",
    width: 1920,
    height: 2333,
  },
];

const photographByKey = Object.fromEntries(photographs.map((photograph) => [photograph.key, photograph]));

const featuredPhotographs = [
  "nessa", "mcmaster", "lakeshore", "group", "formal", "couple",
  "nightlife", "graduation", "purple", "eyewear", "property", "beverage",
].map((key) => photographByKey[key]);

const clients = [
  { name: "Luxetints", logo: "/photography/clients/luxetints.avif" },
  { name: "Health Sciences Musical", logo: "/photography/clients/health-sciences-musical.avif" },
  { name: "McMaster Film Production Club", logo: "/photography/clients/mcmaster-film-production-club.avif" },
  { name: "Matt", logo: "/photography/clients/matt.avif" },
  { name: "McMaster A Cappella", logo: "/photography/clients/mcmaster-a-cappella.avif" },
  { name: "McMaster University", logo: "/photography/clients/mcmaster.avif" },
  { name: "SJK School", logo: "/photography/clients/sjk-school.avif" },
  { name: "McMaster BHSS", logo: "/photography/clients/mcmaster-bhss.avif" },
  { name: "Platinum Moon", logo: "/photography/clients/platinum-moon.avif" },
  { name: "Snazzy Labs", logo: "/photography/clients/snazzy-labs.avif" },
];

const shufflePhotographs = shuffleManifest.images;
const shuffleBatchSize = 36;
---

<BaseLayout
  title="Photography | Will Chai"
  description="Portrait, event, performance, product, property, and film photography by Will Chai."
  path="/photography/"
  pageClass="photographyPage"
>
  <link slot="head" rel="preload" as="image" href="/photography/pixel-photographer.png" />
  <script slot="head" is:inline src="/scripts/photography.js" defer></script>
  <script slot="head" is:inline src="/scripts/photography-collection.js" defer></script>
  <script slot="head" is:inline src="/scripts/photography-arcade.js" defer></script>
  <div class="pageShell">
    <main id="main" class="pageMain">
      <header class="photographyOpening">
        <a class="photographyHome" href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7" /></svg>Back to willchai.com</a>
        <div class="photographyMasthead"><div><p>Will Chai</p><h1>Photography.</h1></div><a class="openingBooking" href="#pricing">Build your shoot<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" /></svg></a></div>
        <p class="photographyLocation">Portraits and events, in Hamilton and across Ontario.</p>
      </header>
      <PhotographyCollection photographs={featuredPhotographs} />

      <section class="clientProof" aria-labelledby="clientProofTitle">
        <div class="clientIntroduction" data-reveal><img src="/photography/concert-mcmaster.avif" alt="A vocalist performing at McMaster University" width="1920" height="2400" loading="lazy" decoding="async" />
        <h2 id="clientProofTitle">Organizations featuring my work.</h2></div>
        <div class="clientLogoRow">
          {
            clients.map((client) => (
              <figure class="clientLogo" data-reveal>
                <img
                  src={client.logo}
                  alt=""
                  width="280"
                  height="140"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{client.name}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <PhotographyArcade />

      <section class="shuffleSection" aria-labelledby="shuffleTitle">
        <header class="shuffleHeader">
          <h2 id="shuffleTitle">A shuffle</h2>
          <div class="shuffleNavigation">
            <button type="button" data-shuffle-reset aria-label="Shuffle the photographs">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h3c4 0 8 12 12 12h3M17 14l4 4-4 4M3 18h3c1.5 0 3-1.7 4.5-4M13.5 10C15 7.7 16.5 6 18 6h3M17 2l4 4-4 4" /></svg>
              Shuffle
            </button>
            <a href="#photography-contact">Contact</a>
          </div>
        </header>
        <div class="shuffleGallery" data-shuffle-gallery>
          {shufflePhotographs.map((photograph, index) => (
            <figure class="shuffleItem" data-shuffle-item hidden={index >= shuffleBatchSize}>
              <a href={photograph.src} data-photo-open data-photo-group="shuffle" aria-label={`Open portfolio photograph ${index + 1}`}>
                <img src={index < shuffleBatchSize ? photograph.src : undefined} data-src={index >= shuffleBatchSize ? photograph.src : undefined} alt={`Portfolio photograph ${index + 1}`} width={photograph.width} height={photograph.height} loading="lazy" decoding="async" />
              </a>
            </figure>
          ))}
        </div>
        <div class="shuffleControls">
          <button type="button" data-shuffle-more>Load more photographs</button>
          <a href="#photography-contact">Get in touch<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7" /></svg></a>
          <p class="visuallyHidden" data-shuffle-status aria-live="polite">{shuffleBatchSize} photographs shown</p>
        </div>
        <noscript><style>[data-shuffle-more], [data-shuffle-reset] { display: none; }</style></noscript>
      </section>
    </main>
    <PhotographyFooter />
    <PhotographyLightbox />
  </div>
</BaseLayout>
