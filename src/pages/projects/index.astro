---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ContactTicket from "../../components/ContactTicket.astro";
import MedTermsScene from "../../components/projects/MedTermsScene.astro";
import TachyboardScene from "../../components/projects/TachyboardScene.astro";
import SearingScene from "../../components/projects/SearingScene.astro";
import ConspiraSeaScene from "../../components/projects/ConspiraSeaScene.astro";
import "../../styles/projects.css";
---

<BaseLayout
  title="Projects | Will Chai"
  description="Medical terminology games, typing practice, dinner conversations and social deduction. Projects by Will Chai."
  path="/projects/"
  pageClass="projectsPage"
>
  <div class="pageShell">
    <SiteHeader current="projects" />
    <main id="main" class="showtell" data-showtell>
      <header
        class="showOpening"
        data-scene="hello"
        data-speech="I’ve brought a few things."
        data-entrance={JSON.stringify([
          { pose: "wave", duration: 800 },
          { pose: "look", duration: 700 },
          { pose: "rest", duration: 500 },
        ])}
      >
        <h1 aria-label="Projects.">
          <span class="titleLetter">
            P
            <span
              class="support"
              data-support
              data-x="0.6"
              data-y="0.21"
            ></span>
          </span>
          <span>rojects.</span>
        </h1>
        <p>A few things I’ve been making.</p>
        <button
          class="guideToggle"
          type="button"
          data-guide-toggle
          aria-pressed="true"
          hidden
        >
          Hide Will
        </button>
      </header>
      <MedTermsScene />
      <TachyboardScene />
      <SearingScene />
      <ConspiraSeaScene />
      <ContactTicket guide />
      <div class="showGuide" data-guide hidden>
        <div class="guideSprite" data-guide-sprite aria-hidden="true"></div>
        <button class="guideJump" type="button" data-guide-jump aria-label="Make Will jump"></button>
        <img
          class="guideProp"
          data-guide-prop
          alt=""
          width="128"
          height="128"
          hidden
        />
        <div class="guideBubble" data-guide-bubble aria-hidden="true" hidden>
          <p data-guide-speech></p>
        </div>
      </div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
<script>
  import "../../scripts/project-roles";
  import "../../scripts/projects-showtell";
  import "../../scripts/project-typing";
</script>
