---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import FilmChapterEnd from '../../components/FilmChapterEnd.astro';
import FilmHero from '../../components/FilmHero.astro';
import FilmSequence from '../../components/FilmSequence.astro';
import FilmRecognition from '../../components/FilmRecognition.astro';
import FilmClosing from '../../components/FilmClosing.astro';
import FilmTrailer from '../../components/FilmTrailer.astro';
import FilmViewer from '../../components/FilmViewer.astro';
import { films } from '../../data/films';
import '../../styles/films.css';
const programme = [...films].reverse();
---
<BaseLayout title="Wattleseed & Murder of Minus | Films by William Chai" description="Explore Wattleseed and Murder of Minus by filmmaker William Chai. Watch trailers, read production stories and credits, and view festival recognition." path="/films/" image="/assets/films/minus-portrait.avif" imageAlt="Murder of Minus" pageClass="filmsPage filmCinema">
  <div class="filmSiteHeader"><SiteHeader current="films" /></div>
  <main id="main">
    <h1 class="visuallyHidden">Films</h1>
    {programme.map((film, index) => <><FilmHero film={film} first={index === 0} /><FilmSequence film={film} /><FilmRecognition film={film} /><FilmChapterEnd film={film} /></>)}
    <FilmClosing />
  </main>
  <FilmTrailer /><FilmViewer />
</BaseLayout>
