---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilmsEnding from "../../components/FilmsEnding.astro";
import FilmTrailer from "../../components/FilmTrailer.astro";
import FilmTransitions from "../../components/FilmTransitions.astro";
import FilmHero from "../../components/FilmHero.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { films } from "../../data/films";
import "../../styles/films.css";
---
<BaseLayout title="Films | Will Chai" description="Films by Will Chai. Wattleseed and Murder of Minus." path="/films/" image={films[0].still} imageAlt={films[0].stillAlt} pageClass="filmsPage filmCinema">
  <FilmTransitions slot="head" />
  <div class="filmSiteHeader"><SiteHeader current="films" /></div>
  <main id="main">
    <header class="filmIntroduction"><h1>I am a filmmaker.</h1></header>
    {films.map((film, index) => <>
      <FilmHero film={film} first={index === 0} />
      <section class="filmPassage" aria-label={`${film.title} synopsis`}>
        <p>{film.summary}</p>
        <a class="filmLink" href={`/films/${film.slug}/`}>Film details<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
      </section>
    </>)}
    <FilmsEnding />
  </main>
  <FilmTrailer />
</BaseLayout>
