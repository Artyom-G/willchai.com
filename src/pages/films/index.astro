---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilmsEnding from "../../components/FilmsEnding.astro";
import FilmTrailer from "../../components/FilmTrailer.astro";
import FilmTransitions from "../../components/FilmTransitions.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { films } from "../../data/films";
import "../../styles/films.css";
---
<BaseLayout title="Films | Will Chai" description="Wattleseed and Murder of Minus. Independent films made by Will Chai with friends and collaborators." path="/films/" image={films[0].still} imageAlt={films[0].stillAlt} pageClass="filmsPage">
  <FilmTransitions slot="head" />
  <div class="pageShell filmsPageShell">
    <SiteHeader current="films" />
    <main id="main" class="filmsShell">
      <header class="filmsOpening">
        <div class="filmsIntro"><h1>Films.</h1><p>I make films with friends. These two follow people caught up in their own inventions.</p></div>
      </header>
      <section class="filmProgramme" aria-label="Selected films">
        {films.map((film, index) => <article class="filmEntry">
          <div class="filmEntryMeta"><span>0{index + 1}</span><p>{film.year}<span aria-hidden="true"> / </span>{film.runtime}</p></div>
          <a class="filmEntryArt" href={`/films/${film.slug}/`} aria-label={`Explore ${film.title}`}>
            <div class="filmEntryFrame" style={`view-transition-name:film-${film.slug}`}><img class="filmEntryStill" src={film.still} srcset={film.stillSrcSet} sizes="(max-width: 46rem) calc(100vw - 2rem), (max-width: 96rem) calc(100vw - 8rem), 84rem" alt={film.stillAlt} width={film.stillWidth} height={film.stillHeight} fetchpriority={index === 0 ? "high" : "auto"} /></div>
            <img class="filmEntryPoster" src={film.poster} alt={film.posterAlt} width={film.posterWidth} height={film.posterHeight} />
          </a>
          <div class="filmEntryCopy">
            <h2><a href={`/films/${film.slug}/`}>{film.title}</a></h2>
            <p class="filmEntrySummary">{film.summary}</p>
            <p class="filmByline">{film.directorLine}</p>
            <div class="filmEntryActions"><a class="filmTextAction" href={`/films/${film.slug}/`}>Explore the film<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a><a class="filmTrailerAction" href={film.links[0].href} data-trailer={film.slug}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7z" /></svg>Watch trailer</a></div>
          </div>
        </article>)}
      </section>
      <FilmsEnding />
    </main>
    <FilmTrailer />
  </div>
</BaseLayout>
