---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 | Will Chai"
  description="Return to the current photography, films, projects, and contact details on willchai.com."
  path="/404/"
  pageClass="notFoundPage"
>
  <meta slot="head" name="robots" content="noindex" />
  <main id="main" class="notFound">
    <section class="notFoundCopy" aria-labelledby="notFoundTitle">
      <p class="sectionMarker">404</p>
      <h1 id="notFoundTitle" class="notFoundTitle">The current collection starts at home.</h1>
      <p>Photography, films, projects, and contact details are ready from the main index.</p>
      <a class="notFoundAction" href="/">Return home</a>
    </section>
    <div class="notFoundMark" aria-hidden="true">
      <img src="/assets/willchai-mark.avif" alt="" width="320" height="320" />
    </div>
  </main>
</BaseLayout>
