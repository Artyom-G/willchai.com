---
import type { FilmLaurel } from '../data/films';
interface Props { festival: string; results: FilmLaurel[]; featured?: boolean; }
const { festival, results, featured = false } = Astro.props;
const artwork = results.find(result => result.artwork);
const website = results.find(result => result.website)?.website;
const dense = results.filter(result => result.category).length >= 5;
const sets = [...new Set(results.map(result => `${result.outcome}|${result.year}`))].map(key => {
  const records = results.filter(result => `${result.outcome}|${result.year}` === key);
  return { outcome: records[0].outcome, year: records[0].year, records };
});
---
<li class:list={['filmLaurelGroup', { filmLaurelFeature: featured, filmLaurelDense: dense, filmLaurelTextOnly: !artwork }]}>
  {artwork && <div class="filmLaurelArtwork" aria-hidden="true"><img src={artwork.artwork} alt="" width="500" height="320" loading="lazy" /></div>}
  <div class="filmLaurelCopy">
  <h3>{website ? <a href={website}>{festival}</a> : festival}</h3>
  {sets.map(set => <div class="filmLaurelSet">
    <p class="filmLaurelStatus">{set.outcome} · {set.year}</p>
    {set.records.some(result => result.category) && <ul class="filmLaurelResults">{set.records.filter(result => result.category).map(result => <li class="filmLaurelResult" data-outcome={result.outcome}>
      {result.category && (result.source ? <a href={result.source}>{result.category}</a> : <span>{result.category}</span>)}
    </li>)}</ul>}
  </div>)}
  </div>
</li>
