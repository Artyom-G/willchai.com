<section class="shootArcade" id="pricing" aria-labelledby="arcadeTitle" data-shoot-arcade>
  <header class="arcadeWelcome">
    <div><h2 id="arcadeTitle">Make it your shoot.</h2><p>Give your idea a name. We can work out the photographs and the price together.</p></div>
    <button class="sceneReplay" type="button" data-replay-scene hidden>Replay the shove<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M19 12a7 7 0 1 0-2 5M20 12a7 7 0 0 0-2-5" /></svg></button>
  </header>
  <div class="arcadeCabinet">
    <form class="shootBuilder" data-shoot-builder>
      <fieldset class="shootTypes">
        <legend>What are we photographing?</legend>
        <div class="shootTypeChoices">
          <label><input type="radio" name="kind" value="Portraits" checked /><span>Portraits</span></label>
          <label><input type="radio" name="kind" value="Events" /><span>Events</span></label>
          <label><input type="radio" name="kind" value="Another idea" /><span>Another idea</span></label>
        </div>
      </fieldset>
      <div class="shootCard" data-shoot-card>
        <div class="shootCardFace">
          <div class="shootCardPhoto"><img data-shoot-image src="/photography/portrait-lakeshore.webp" alt="Lakeshore portrait" width="1707" height="2560" loading="lazy" decoding="async" /></div>
          <div class="shootCardContent">
            <div class="shootCardByline"><span data-shoot-kind>Portraits</span><span>with Will Chai</span></div>
            <label class="shootNameLabel" for="shoot-name">Your shoot name <span>(optional)</span></label>
            <textarea id="shoot-name" class="shootName" name="title" rows="2" maxlength="80" placeholder="Your portrait session" autocomplete="off" spellcheck="true" aria-describedby="shoot-name-hint"></textarea>
            <p class="shootNameHint" id="shoot-name-hint" data-shoot-hint>For example, Graduation with friends.</p>
            <div class="shootBudget">
              <label for="shoot-budget">Have a photography budget in mind? <span>(optional)</span></label>
              <div class="shootBudgetInput"><input id="shoot-budget" type="text" name="budget" maxlength="64" placeholder="An amount or range" autocomplete="off" aria-describedby="shoot-currency" /><span id="shoot-currency">CAD</span></div>
              <label class="shootGuidance"><input type="checkbox" name="guidance" value="yes" /><span>I’d like guidance</span></label>
            </div>
            <img class="arcadePointer" src="/assets/pixel-cursor.svg" alt="" width="92" height="112" aria-hidden="true" />
            <p class="shootBudgetSummary" data-budget-summary aria-live="polite">We can work out the budget together.</p>
          </div>
        </div>
        <div class="shootInquiry">
          <button class="inquiryToggle" type="button" data-inquiry-toggle aria-expanded="false" aria-controls="shoot-inquiry" hidden><span>Review your inquiry</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
          <div class="inquiryFold" id="shoot-inquiry" data-inquiry-fold hidden>
            <div class="inquiryLetter">
              <p class="inquirySubject"><span>Subject</span><strong data-inquiry-subject>Your portrait session</strong></p>
              <label class="visuallyHidden" for="inquiry-message">Your inquiry message</label>
              <textarea id="inquiry-message" data-inquiry-message rows="9" readonly></textarea>
            </div>
          </div>
          <div class="inquiryActions">
            <a class="shootSend" data-shoot-send href="mailto:me@willchai.com?subject=Photography%20inquiry">Open email<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" /></svg></a>
            <button class="shootCopy" type="button" data-copy-inquiry hidden>Copy inquiry<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="1" /><path d="M15 4H4v11" /></svg></button>
          </div>
          <div class="inquiryDestination">
            <button type="button" data-copy-address hidden aria-label="Copy email address">me@willchai.com<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="1" /><path d="M15 4H4v11" /></svg></button>
            <span>Add the date, place and other details in your email.</span>
          </div>
          <p class="inquiryStatus" data-inquiry-status role="status"></p>
        </div>
      </div>
    </form>
    <noscript><p class="arcadeFallback">Send your plans to <a href="mailto:me@willchai.com?subject=Photography%20inquiry">me@willchai.com</a> for a personal quote.</p><style>.shootBuilder{display:none}</style></noscript>
    <div class="goldScene" data-gold-scene aria-hidden="true" inert>
      <div class="goldBackdrop"></div><div class="goldLedge"></div>
      <div class="goldPlan"><div class="goldPlanHeading">Photography packages</div><p class="goldTier">Gold tier</p><p class="goldPackage">Standard event package</p><div class="goldRule"></div><p>A fixed format for every occasion.</p><div class="goldFakeButton">Select package</div></div>
      <div class="pushingWill"><span class="pushingWillSprite"></span></div>
    </div>
  </div>
  <div class="arcadeBelow"><a href="mailto:me@willchai.com?subject=Photography%20inquiry">Or email me directly</a><a href="/photography/services-policy.pdf">Service policy</a></div>
</section>
