<section class="photoInquiry" id="pricing" aria-labelledby="inquiryTitle" data-photo-inquiry>
  <div class="photoInquiryCopy">
    <h2 id="inquiryTitle">Build your shoot.</h2>
  </div>
  <form class="photoInquiryForm" data-photo-inquiry-form action="mailto:me@willchai.com?subject=Photography%20inquiry">
    <label class="visuallyHidden" for="shoot-name">Event name</label>
    <input id="shoot-name" name="title" type="text" placeholder="Event name" maxlength="80" autocomplete="off" />
    <label class="visuallyHidden" for="shoot-location">Where?</label>
    <input id="shoot-location" name="location" type="text" placeholder="Where?" maxlength="160" autocomplete="off" />
    <label class="visuallyHidden" for="shoot-date">When?</label>
    <input id="shoot-date" name="date" type="text" placeholder="e.g. Sometime in August" maxlength="120" autocomplete="off" />
    <button type="submit">Start an email</button>
  </form>
</section>
