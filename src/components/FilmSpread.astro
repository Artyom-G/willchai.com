---
import type { Film } from '../data/films';
import FilmImage from './FilmImage.astro';
interface Props { film: Film; detail?: boolean; }
const { film, detail = false } = Astro.props;
const wattle = film.slug === 'wattleseed';
const gallery = film.gallery || [];
---
<section class:list={['filmSpread', { filmSpreadMinus: !wattle }]} id={detail ? 'about' : `about-${film.slug}`} aria-label={`${film.title} images and synopsis`}>
  {gallery[0] && <FilmImage image={gallery[0]} class="filmSpreadLead" sizes="(max-width: 703px) 100vw, 64vw" />}
  <div class="filmSpreadCopy">
    <p class="filmSynopsis">{detail ? film.introduction : film.summary}</p>
    <div class="filmActions">
      <a class="filmLink" href={film.links.find(link => link.label === 'Press kit')?.href}>Press kit<span aria-hidden="true">↗</span></a>
      <a class="filmLink" href={detail ? film.links[1].href : `/films/${film.slug}/`}>{detail ? film.links[1].label : 'Film details'}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
  {gallery[1] && <FilmImage image={gallery[1]} class="filmSpreadSecond" />}
  <div class="filmSpreadNote">
    <p>{film.story[0]}</p>
    {!wattle && <p class="filmPrincipalCredit">Written and directed by<br />Will Chai and Artyom Gabtraupov</p>}
  </div>
  {!wattle && <FilmImage image={{src:film.still,srcSet:film.stillSrcSet,width:film.stillWidth,height:film.stillHeight,alt:film.stillAlt}} class="filmSpreadDaylight" />}
  {detail && <div class="filmProduction"><h2>Production</h2>{film.story.slice(1).map(paragraph => <p>{paragraph}</p>)}</div>}
</section>
