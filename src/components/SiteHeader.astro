---
interface Props {
  current?: "photography" | "films" | "projects" | "resume" | "hey";
}

const { current } = Astro.props;
const links = [
  { key: "photography", label: "Photography", href: "/photography/" },
  { key: "films", label: "Films", href: "/films/" },
  { key: "projects", label: "Projects", href: "/projects/" },
  { key: "resume", label: "Résumé", href: "/resume/" },
];
---

<header class="siteHeader">
  <a class="siteBrand" href="/" aria-label="Will Chai, home">
    <img src="/assets/willchai-mark.avif" alt="" width="42" height="42" />
    <span>willchai.com</span>
  </a>
  <nav class="siteNav" aria-label="Primary navigation">
    {
      links.map((link) => (
        <a href={link.href} aria-current={current === link.key ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <a class="headerContact" href="mailto:me@willchai.com">Contact</a>
</header>
