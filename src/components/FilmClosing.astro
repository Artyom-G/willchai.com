---
import { films } from '../data/films';
import FilmsEnding from './FilmsEnding.astro';
---
<section class="filmClosing" aria-label="Films">
  {films.map(film => <a href={`/films/${film.slug}/`}><img src={film.poster} alt={`${film.title} poster`} width={film.posterWidth} height={film.posterHeight} loading="lazy" /><div><span>{film.year}</span><h2>{film.title}</h2><span>Film details ↗</span></div></a>)}
</section>
<FilmsEnding />
