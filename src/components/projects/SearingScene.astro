---
import { getProject } from "../../data/projects";
const project = getProject("searing-stories")!;
---
<section id="searing" class="projectScene searingScene" data-scene="searing" data-speech="We interview cool people in exchange for a hearty meal..." data-entrance={JSON.stringify([{pose:"wave",duration:650},{pose:"present",duration:700}])} aria-labelledby="searing-title">
  <div class="searingHero"><img class="searingDinner" src="/assets/projects-v5/searing-landing.avif" alt="Steak and fries served by candlelight at Searing Stories" width="768" height="534" loading="lazy" /><h2 id="searing-title"><a href={project.primaryHref} class="projectTitleLink searingMasthead" aria-label="Searing Stories"><span aria-hidden="true">Searing</span><span aria-hidden="true">Stories</span></a></h2></div>
  <div class="searingInvitation"><div class="hostPortrait"><img src="/assets/projects-v5/searing-hosts.avif" alt="Edward Gao and William Chai in chef jackets" width="768" height="576" loading="lazy" /><span class="support" data-support data-x="0.75" data-mobile-x="0.74" data-y="0"></span></div><div class="searingCopy"><p class="searingThesis"><a class="projectTextLink" href={project.primaryHref}>Candid stories served over a nice dinner.</a></p><p>Hosted by Edward Gao and William Chai.</p><p>Home cooked dinner, an unhurried conversation, and stories from the people at our table.</p><a class="searingAction" data-primary href={project.primaryHref}>Read Searing Stories</a></div></div>
</section>
<style>
 .searingScene{background:var(--wc-project-searing-rust);color:var(--wc-white);padding:0;}.searingHero{height:560px;position:relative;isolation:isolate;display:flex;align-items:center;padding:clamp(30px,5vw,80px);overflow:visible;}.searingDinner{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 58%;z-index:-2;}.searingHero::after{content:"";position:absolute;inset:0;background:#0002;z-index:-1;}.searingHero h2{margin:0;max-width:720px;width:64%;overflow:visible;}.searingHero h2 .searingMasthead{display:flex;flex-direction:column;align-items:flex-start;width:max-content;max-width:100%;color:#fff;text-decoration:none;font-family:Georgia,serif;font-size:clamp(5rem,10.6vw,9.5rem);font-weight:600;letter-spacing:-.08em;line-height:.72;filter:drop-shadow(0 2px 4px #0007);}.searingScene[data-title-font="ready"] .searingMasthead{font-family:"Project Searing",cursive;font-weight:400;letter-spacing:0;}.searingMasthead>span{display:block;}.searingMasthead>span+span{margin-left:clamp(3rem,13vw,10.5rem);}
 .searingInvitation{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:clamp(32px,6vw,90px);align-items:center;padding:140px clamp(30px,6vw,90px) 58px;}.hostPortrait{position:relative;max-width:440px;border:3px solid #fff;}.hostPortrait>img{display:block;width:100%;height:auto;}.searingCopy{max-width:530px;}.searingCopy p{font-size:17px;line-height:1.55;margin:0 0 18px;}.searingCopy .searingThesis{font-size:clamp(24px,2.4vw,34px);line-height:1.24;margin-bottom:18px;}.searingCopy p:nth-child(2){font-size:15px;color:#edd1c5;}.searingAction{display:inline-flex;justify-content:center;align-items:center;border-radius:100px;background:var(--wc-white);color:#111;min-height:46px;padding:12px 28px;text-decoration:none;font-size:16px;margin-top:12px;}.searingAction:hover{background:#d95a36;color:#fff;}
 @media(max-width:700px){.searingHero{height:390px;padding:26px;}.searingHero h2{width:100%;}.searingHero h2 .searingMasthead{font-size:clamp(4rem,19vw,5.8rem);line-height:.74;}.searingMasthead>span+span{margin-left:clamp(2.5rem,12vw,4.75rem);}.searingDinner{object-position:53% 50%;}.searingInvitation{display:flex;flex-direction:column;padding:116px 28px 38px;gap:28px;align-items:stretch;}.hostPortrait{max-width:360px;}.searingCopy .searingThesis{font-size:25px;}.searingCopy p{font-size:16px;}.searingAction{width:100%;}}
</style>
