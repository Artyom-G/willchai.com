---
import type { FilmLaurel } from '../data/films';
import FilmLaurelGroup from './FilmLaurelGroup.astro';
interface Props { laurels: FilmLaurel[]; }
const { laurels } = Astro.props;
const groups = [...new Set(laurels.map(item => item.festival))].map(festival => {
  const results = laurels.filter(item => item.festival === festival);
  const presentation = results.find(item => item.emphasis);
  return { festival, results, emphasis: presentation?.emphasis || 'supporting', order: presentation?.order || 99, shortName: presentation?.shortName };
}).sort((a, b) => a.order - b.order);
const festivals = groups.filter(group => group.emphasis !== 'compact');
const circuit = groups.filter(group => group.emphasis === 'compact');
const circuitStatuses = [...new Set(circuit.flatMap(group => group.results.map(result => `${result.outcome} · ${result.year}`)))];
---
<ul class="filmLaurels" aria-label="Festival recognition">
  {festivals.map(group => <FilmLaurelGroup festival={group.festival} results={group.results} featured={group.emphasis === 'feature'} />)}
  {circuit.length > 0 && <li class="filmLaurelGroup filmFestivalCircuit">
    <h3>Lift Off</h3>
    <p class="filmLaurelStatus">{circuitStatuses.join(' / ')}</p>
    <ul>{circuit.map(group => <li class="filmLaurelCompact">
      <a href={group.results[0].website} aria-label={`${group.festival}, official website`}>{group.shortName}</a>
      {group.results.map(result => <span class="filmCircuitCategory">{result.category}</span>)}
    </li>)}</ul>
  </li>}
</ul>
